{
  "name": "gestion-operativa-acuasan",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite acusan/frontend",
    "dev:api": "npm --prefix acusan/backend run dev",
    "build": "prisma generate --schema=acusan/backend/prisma/schema.prisma && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "prisma": "^6.3.1",
    "vite": "^8.2.0"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true,
    "tesseract.js": true
  }
}
