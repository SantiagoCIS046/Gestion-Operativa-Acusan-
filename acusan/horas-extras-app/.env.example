# URL base del backend para la app de Horas Extras.
#
# En desarrollo DEJAR VACÍO: el proxy de Vite redirige /api → http://127.0.0.1:3000
# (ver server.proxy en vite.config.js) y las peticiones usan rutas relativas.
#
# En producción (app desplegada separada del backend) apunta al dominio del backend:
#   VITE_API_URL=https://tu-dominio-acuusan.vercel.app
VITE_API_URL=
