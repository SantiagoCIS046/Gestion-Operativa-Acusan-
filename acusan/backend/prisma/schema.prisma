// Prisma schema file for Acuusan Gestión Operativa (MongoDB Atlas)
// Sistema reducido al módulo de AUTENTICACIÓN (2026-10-16): el resto de
// módulos fue eliminado. Las colecciones legacy permanecen intactas en Atlas.

generator client {
  provider      = "prisma-client-js"
  // Vercel construye en Linux y la función lambda corre en Amazon Linux:
  // se generan los motores para build (debian) y runtime (rhel/lambda).
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// MÓDULO: AUTENTICACIÓN DE USUARIOS
// -------------------------------------------------------------
enum RolUsuario {
  ADMIN
  ADMINISTRADOR
  ENCARGADO
  GERENCIA
  OPERATIVO
  RADICADOS
  CLIENTE
}

model Usuario {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  nombre        String
  email         String     @unique
  password      String
  rol           RolUsuario
  cedula        String?
  cargo         String?
  activo        Boolean    @default(true)
  ultimoAcceso  DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accesos       RegistroAcceso[]

  @@map("usuarios")
}

// -------------------------------------------------------------
// MÓDULO: REGISTRO DE ACCESOS (AUDIT LOG DEL LOGIN)
// -------------------------------------------------------------
model RegistroAcceso {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  usuarioId     String     @db.ObjectId
  usuario       Usuario    @relation(fields: [usuarioId], references: [id])
  nombreUsuario String
  emailUsuario  String
  rolUsuario    RolUsuario
  cargoUsuario  String?
  ipAddress     String?
  userAgent     String?
  fechaAcceso   DateTime   @default(now())

  @@map("registros_acceso")
}
