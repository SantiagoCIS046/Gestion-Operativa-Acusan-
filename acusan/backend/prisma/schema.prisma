// Prisma schema file for Acuasan Gestión Operativa (MongoDB Atlas)

generator client {
  provider      = "prisma-client-js"
  // Vercel construye en Linux y la función lambda corre en Amazon Linux:
  // se generan los motores para build (debian) y runtime (rhel/lambda).
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// MÓDULO: PERMISOS LABORALES & OCR
// -------------------------------------------------------------
enum EstadoPermiso {
  PENDIENTE
  APROBADO
  RECHAZADO
  EN_REVISION
}

enum TipoPermiso {
  CALAMIDAD
  MEDICO
  PERSONAL
  COMPENSATORIO
  ESTUDIO
}

model Permiso {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  radicado          String        @unique
  // Identificador del cliente para idempotencia de la sincronización offline
  idLocal           String?       @unique
  cedula            String
  nombreFuncionario String
  cargo             String?
  dependencia       String?
  tipo              TipoPermiso
  fechaInicio       DateTime
  fechaFin          DateTime
  duracion          String?
  // true cuando el horario del permiso coincide con la jornada completa del día
  // (lunes a jueves 07:30–18:00, viernes 07:30–17:30). Lo marca el frontend.
  jornadaCompleta   Boolean       @default(false)
  hora24            String?
  justificacion     String?
  motivoManuscrito  String?
  soporte           String?
  soporteUrl        String?
  archivoUrl        String?
  archivoMimeType   String?
  ocrConfidence     Float?        @default(0)
  ocrRawPayload     Json?
  estado            EstadoPermiso @default(PENDIENTE)
  aprobadoPor       String?
  fechaAprobacion   DateTime?
  observaciones     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("permisos")
}

// -------------------------------------------------------------
// MÓDULO: HORAS EXTRAS & RECARGOS
// -------------------------------------------------------------
enum TipoHoraExtra {
  DIURNA
  NOCTURNA
  FESTIVA_DIURNA
  FESTIVA_NOCTURNA
}

enum EstadoHoraExtra {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model HoraExtra {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  cedula          String
  funcionario     String
  cuadrillaArea   String
  fechaOperacion  DateTime
  tipoRecargo     TipoHoraExtra
  cantidadHoras   Float
  montoEstimado   Float           @default(0)
  estado          EstadoHoraExtra @default(PENDIENTE)
  justificacion   String?
  autorizadoPor   String?
  fechaAprobacion DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("horas_extras")
}

// -------------------------------------------------------------
// MÓDULO: PQR (Peticiones, Quejas, Reclamos & Recursos)
// -------------------------------------------------------------

// Contador atómico para radicados secuenciales sin colisiones.
// La operación $inc de MongoDB es la única forma segura de
// autoincremental sin transacciones ACID en alta concurrencia.
model ContadorSecuencial {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  // Clave del contador, ej: "PQR-2026"
  clave  String @unique
  // Último número emitido (comienza en 0)
  ultimo Int    @default(0)

  @@map("contadores_secuenciales")
}

enum EstadoPQR {
  ABIERTO
  EN_TRAMITE
  RESUELTO
  ANULADO
}

enum PrioridadPQR {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

// Ciudadano o usuario externo que radica la PQR.
// Se busca por teléfono; si no existe se crea en el acto.
model UsuarioPQR {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  telefono   String   @unique
  nombre     String
  cedulaNit  String?
  email      String?
  direccion  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pqrs       PQR[]

  @@map("usuarios_pqr")
}

model PQR {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  radicado         String       @unique
  // Identificador del cliente para idempotencia de la sincronización offline
  // (evita duplicados al reintentar el POST de un registro pendiente)
  idLocal          String?      @unique

  // Relación con el ciudadano que radica
  usuarioPqrId     String?      @db.ObjectId
  usuarioPqr       UsuarioPQR?  @relation(fields: [usuarioPqrId], references: [id])

  // Campos planos heredados (compatibilidad hacia atrás con datos existentes)
  usuario          String
  cedulaNit        String?
  matricula        String?
  telefono         String?
  email            String?
  direccion        String?
  motivo           String
  descripcion      String
  remitente        String       @default("IA") // "IA" (WhatsApp) u "OPERADOR" (Ventanilla / Manual)
  horaInicio       String?      // Hora en que empezó la interacción/reporte (ej: "09:15 a. m.")
  horaFin          String?      // Hora en que terminó la interacción/reporte (ej: "09:22 a. m.")
  duracionMinutos  Int?         // Tiempo total transcurrido en minutos
  conversacion     Json?        // Hilo íntegro y exacto de mensajes WhatsApp entre usuario e IA
  prioridad        PrioridadPQR @default(MEDIA)
  estado           EstadoPQR    @default(ABIERTO)
  fechaRadicado    DateTime     @default(now())
  fechaVencimiento DateTime
  respuestaOficial String?
  fechaRespuesta   DateTime?
  respondidoPor    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  historial        HistorialEstadoPQR[]

  @@map("pqrs")
}

// Registro inmutable de cada cambio de estado de la PQR.
// Nunca se actualiza, solo se inserta → auditoria perfecta.
model HistorialEstadoPQR {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  pqrId        String    @db.ObjectId
  pqr          PQR       @relation(fields: [pqrId], references: [id])
  estadoAntes  String?
  estadoDespues String
  actor        String    // email o "sistema" / "WhatsApp"
  observaciones String?
  creadoEn     DateTime  @default(now())

  @@map("historial_estado_pqr")
}

// -------------------------------------------------------------
// MÓDULO: AUTENTICACIÓN DE USUARIOS
// -------------------------------------------------------------
enum RolUsuario {
  ADMIN
  ADMINISTRADOR
  ENCARGADO
  GERENCIA
  OPERATIVO
  RADICADOS
  CLIENTE
}


model Usuario {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  nombre        String
  email         String     @unique
  password      String
  rol           RolUsuario
  cedula        String?
  cargo         String?
  activo        Boolean    @default(true)
  ultimoAcceso  DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accesos       RegistroAcceso[]

  @@map("usuarios")
}

// -------------------------------------------------------------
// MÓDULO: REGISTRO DE ACCESOS (AUDIT LOG)
// -------------------------------------------------------------
model RegistroAcceso {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  usuarioId   String     @db.ObjectId
  usuario     Usuario    @relation(fields: [usuarioId], references: [id])
  nombreUsuario String
  emailUsuario  String
  rolUsuario    RolUsuario
  cargoUsuario  String?
  ipAddress   String?
  userAgent   String?
  fechaAcceso DateTime   @default(now())

  @@map("registros_acceso")
}

// -------------------------------------------------------------
// MÓDULO: GESTIÓN DE RADICADOS DOCUMENTALES & VENCIMIENTOS
// -------------------------------------------------------------
model Radicado {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  numeroRadicado    String   @unique
  // Identificador opcional del cliente
  idLocal           String?
  fechaRadicacion   DateTime @default(now())

  // Campos del documento PDF / OCR
  peticionario      String
  dependencia       String
  destinatario      String?
  asunto            String?
  referencia        String?
  fechaDocumento    String?
  lugarFecha        String?
  numeroRadicadoPdf String?

  // Campos operacionales
  correoDrive       String?
  registradoPor     String?
  contexto          String?
  estado            String   @default("Pendiente")
  fechaVencimiento  DateTime
  urlDrive          String?
  archivoNombre     String?
  archivoUrl        String?
  archivoBase64     String?
  createdAt         DateTime @default(now())

  updatedAt         DateTime @updatedAt

  @@map("radicados")
}

// -------------------------------------------------------------
// MÓDULO: RADICADOS — OFICIOS DE RESPUESTA ARCHIVADOS
// -------------------------------------------------------------
// Cada radicado puede tener una o varias respuestas (oficios de salida)
// escaneadas y archivadas en la base de datos. Se enlaza al radicado padre
// por radicadoId SIN @relation deliberadamente: el modelo Radicado queda
// intacto (cero riesgo para los datos existentes). numeroRadicado va
// desnormalizado (lo fija el servidor al crear) para listar y mostrar en
// Gerencia sin cruzar colecciones.
model RespuestaRadicado {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  radicadoId     String   @db.ObjectId
  numeroRadicado String

  // Fecha en que se archivó la respuesta en el sistema
  fechaRespuesta DateTime @default(now())

  // Campos del oficio (OCR estricto: el dato sale del documento o va vacío)
  numeroOficio   String?
  destinatario   String?
  asunto         String?
  fechaDocumento String?
  lugarFecha     String?
  // Funcionario que firma el oficio (nombre + cargo), del bloque de firma
  firmante       String?
  observaciones  String?

  // Documento escaneado de la respuesta (data URL base64, igual que radicados)
  archivoNombre  String?
  archivoBase64  String?

  registradoPor  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("respuestas_radicado")
}

