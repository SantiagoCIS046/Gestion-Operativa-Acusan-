{
  "name": "acuasan-backend",
  "version": "1.0.0",
  "description": "API Backend para Gestión Operativa Acuusan E.S.P.",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "informes:recalcular": "node scripts/recalcular-informes.mjs",
    "claves:generar": "node scripts/generar-clave.mjs",
    "datos:cifrar": "node scripts/cifrar-datos-existentes.mjs",
    "datos:respaldar": "node scripts/respaldar-datos.mjs",
    "cifrado:integrar": "node scripts/integrar-cifrado.mjs",
    "test": "node --test --test-concurrency=1",
