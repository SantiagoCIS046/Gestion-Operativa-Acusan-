# Entorno del backend — copiar a backend/.env (que NO se sube al repo)
PORT=3000
NODE_ENV=development

# ── Base de datos (MongoDB Atlas) ─────────────────────────────────────────────
# Cadena de conexión real desde mongodb.com (Database → Connect → Drivers).
# Reemplaza USUARIO, <db_password> y el cluster por los tuyos.
DATABASE_URL="mongodb+srv://USUARIO:<db_password>@CLUSTER.mongodb.net/acuusan_db?appName=Cluster0"

# ── Sesiones (JWT) ────────────────────────────────────────────────────────────
# Secreto para firmar los tokens. Genera uno fuerte, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Vigencia del token de sesión (default 8h)
JWT_EXPIRES_IN=8h

# ── Cifrado de datos sensibles ────────────────────────────────────────────────
# Llave maestra (32 bytes en hex) con la que se cifran número, asunto,
# remitente y demás datos de los radicados, sus PDFs, alertas y eventos.
# Genérala UNA vez:  npm run claves:generar -- --guardar   (desde backend/)
# - Sin ella el backend no arranca.
# - Si se cambia o se pierde, los datos cifrados quedan ilegibles: guarda una
#   copia en un gestor de contraseñas y ponla igual en Vercel.
CLAVE_MAESTRA_DATOS=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Orígenes extra permitidos además de los fijos (producción propia, etc.),
# separados por coma. Los dominios institucionales ya vienen incluidos en app.js
FRONTEND_URLS=

# ── Cron de alertas ───────────────────────────────────────────────────────────
# Secreto que protege POST|GET /api/cron/alertas (header x-cron-secret,
# Authorization: Bearer o ?secreto=…). Igual al que use el programador externo.
# Ver README.md → "Alertas diarias"
CRON_SECRET=

# ── Correo (SMTP) ─────────────────────────────────────────────────────────────
# Sin estas variables el sistema NO falla: los envíos solo quedan en el log
# (backend/src/services/correo.js) y las contraseñas temporales se entregan
# en persona. Con SMTP: invitaciones, recuperación y resumen de alertas.
# SMTP_SECURE=true para puerto 465; false (o vacío) para 587 (STARTTLS).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
CORREO_REMITENTE=
# URL pública de la app (arma los enlaces de invitación/recuperación)
APP_URL=

# ── PDFs fuera de la base (opcional) ──────────────────────────────────────────
# Dónde viven los bytes de los PDFs (siempre cifrados):
#   mongo (default) | blob (Vercel Blob) | disco (carpeta del servidor)
# Mudar los existentes: npm run pdfs:mover -- --simular  y luego sin --simular
ALMACEN_PDF=mongo
BLOB_READ_WRITE_TOKEN=
ALMACEN_PDF_DIR=
