PORT=3000
NODE_ENV=development

# ── WhatsApp Cloud API (webhook PQR) ──────────────────────────────────────────
# Token que Meta envía en hub.verify_token al verificar el webhook (lo defines
# tú en la configuración de la app en developers.facebook.com — inventa uno fuerte)
WHATSAPP_VERIFY_TOKEN=
# App Secret de la app de Meta: valida la firma X-Hub-Signature-256 de cada POST.
# Vacío en desarrollo = la validación de firma se omite (con advertencia en log)
WHATSAPP_APP_SECRET=

# ── WhatsApp Cloud API: ENVÍO de mensajes (Graph API) ─────────────────────────
# Token de acceso del sistema (developers.facebook.com → WhatsApp → Configuración
# de la API). Usa un token permanente, no uno temporal de 24h
WHATSAPP_TOKEN=
# ID del número de teléfono de la cuenta de WhatsApp Business (misma pantalla)
WHATSAPP_PHONE_NUMBER_ID=
# Versión de la Graph API (opcional)
WHATSAPP_API_VERSION=v22.0

# ── WebSockets (Socket.io) ────────────────────────────────────────────────────
# Orígenes habilitados para conectar operadores, separados por coma
# (producción Vercel + desarrollo local). Default ya incluye ambos
FRONTEND_URLS=https://acuusan.vercel.app,http://localhost:5173

# ── IA conversacional (Gemini) ────────────────────────────────────────────────
# API key de Google AI Studio (https://aistudio.google.com) para el asistente PQR
GEMINI_API_KEY=
# Modelo a usar (opcional; el default es gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# MongoDB Atlas Connection String
DATABASE_URL="mongodb+srv://SantiagoCis046:<db_password>@cluster0.qtyaki3.mongodb.net/acuasan_db?appName=Cluster0"

# Motor OCR Python (puente Node → Flask local)
OCR_PY_URL=http://127.0.0.1:5001
OCR_PY_TIMEOUT_MS=90000
