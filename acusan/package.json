{
  "name": "gestion-operativa-acuusan",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite frontend",
    "dev:api": "npm --prefix backend run dev",
    "db:push": "node scripts/db-push.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "alertas:diarias": "node scripts/alertas-diarias.mjs",
    "build": "prisma generate --schema=backend/prisma/schema.prisma && vite build",
    "postinstall": "npm --prefix backend install && npm --prefix frontend install",
    "preview": "vite preview"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "bootstrap": "^5.3.8",
    "ogl": "^1.0.11",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "prisma": "^6.3.1",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true
  }
}
